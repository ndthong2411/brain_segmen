{
  "data": {
    "raw_root": "data/raw",
    "proc_root": "data/processed_multiclass",
    "modality": "multi",
    "img_size": 256,
    "slices_per_case": 30,
    "tumor_slice_ratio": 0.5,
    "num_folds": 5,
    "fold": 4
  },
  "train": {
    "epochs": 350,
    "batch_size": 8,
    "lr": 3e-05,
    "weight_decay": 0.0001,
    "workers": 4,
    "loss_type": "ultimate_multitask",
    "seg_loss_weight": 1.0,
    "cls_loss_weight": 0.5,
    "dice_weight": 1.0,
    "focal_weight": 1.0,
    "iou_weight": 2.0,
    "boundary_weight": 0.5,
    "focal_alpha": [
      0.0,
      0.4,
      0.1
    ],
    "focal_gamma": 3.0,
    "class_weights": [
      1.0,
      3.0,
      2.0
    ],
    "ignore_background": true,
    "aux_weight": 0.3,
    "optimizer": "adamw",
    "grad_clip_norm": 1.0,
    "scheduler": "cosine",
    "warmup_steps": 1000,
    "min_lr": 1e-06,
    "amp": true,
    "grad_accum_steps": 2,
    "early_stop_patience": 80,
    "val_interval": 1,
    "log_interval": 10,
    "save_interval": 10
  },
  "logging": {
    "log_dir": "logs",
    "exp_name": "braintumnet_phase2_small"
  },
  "model": {
    "model_type": "v2",
    "in_channels": 4,
    "num_classes_seg": 3,
    "num_classes_cls": 2,
    "base": 48,
    "dim": 384,
    "patch_size": 8,
    "depth": 4,
    "n_heads": 8,
    "dropout": 0.15,
    "norm": "instance",
    "roi_stop_grad": true,
    "deep_supervision": true,
    "multi_scale_fusion": true
  },
  "augment": {
    "rotate_deg": 30,
    "hflip_p": 0.5,
    "vflip_p": 0.5,
    "brightness_range": [
      0.8,
      1.2
    ],
    "contrast_range": [
      0.8,
      1.2
    ]
  }
}