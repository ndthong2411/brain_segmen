{
  "exp_name": "braintumnet_phase1_iou_focus",
  "data": {
    "raw_root": "data/raw",
    "proc_root": "data/processed_multiclass",
    "modality": "multi",
    "img_size": 256,
    "slices_per_case": 30,
    "tumor_slice_ratio": 0.5,
    "num_folds": 5,
    "fold": 4
  },
  "train": {
    "epochs": 300,
    "batch_size": 12,
    "lr": 5e-05,
    "weight_decay": 5e-05,
    "workers": 4,
    "loss_type": "ultimate_multitask",
    "seg_loss_weight": 1.0,
    "cls_loss_weight": 0.5,
    "dice_weight": 1.0,
    "focal_weight": 1.0,
    "iou_weight": 2.0,
    "boundary_weight": 0.5,
    "focal_alpha": [
      0.0,
      0.4,
      0.1
    ],
    "focal_gamma": 3.0,
    "class_weights": [
      1.0,
      3.0,
      2.0
    ],
    "ignore_background": true,
    "aux_weight": 0.3,
    "scheduler": "cosine",
    "warmup_steps": 2000,
    "min_lr": 5e-06,
    "early_stop_patience": 75,
    "early_stop_metric": "val_iou",
    "optimizer": "adamw",
    "gradient_clip": 1.0,
    "amp": true,
    "amp_dtype": "float16"
  },
  "model": {
    "in_channels": 4,
    "num_classes_seg": 3,
    "num_classes_cls": 2,
    "base": 32,
    "patch_size": 8,
    "dim": 256,
    "n_heads": 4,
    "depth": 2,
    "roi_stop_grad": true,
    "deep_supervision": true
  },
  "augment": {
    "rotate_deg": 30,
    "hflip_p": 0.5,
    "vflip_p": 0.5
  },
  "logging": {
    "out_dir": "runs",
    "save_dir": "checkpoints",
    "log_dir": "logs",
    "use_tensorboard": true,
    "log_every_n_steps": 50,
    "save_top_k": 3
  }
}